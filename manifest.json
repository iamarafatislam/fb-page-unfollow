{
  "manifest_version": 3,
  "name": "FB Page Unfollow",
  "version": "1.0.0",
  "description": "Scan and bulk unfollow Facebook pages at a safe adjustable pace.",
  "action": {
    "default_title": "Open FB Page Unfollow"
  },
  "background": {
    "service_worker": "background.js"
  },
  "side_panel": {
    "default_path": "sidepanel.html"
  },
  "permissions": [
    "storage",
    "tabs",
    "scripting",
    "cookies",
    "declarativeNetRequest",
    "sidePanel"
  ],
  "host_permissions": [
    "https://*.facebook.com/*"
  ],
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  }
}
